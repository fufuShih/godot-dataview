# Godot auto generated files
*.gen.*
.godot/

# Godot treats arbitrary CSV files as translation sources. The DataView test
# CSV is read directly, so its generated import sidecars are not source files.
/project/data/*.csv.import
/project/data/*.translation

# Ignore library files but not the gdextension file
/bin/**
!project/bin/*.gdextension

# Ignore scons database
.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
~*.dll*
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json
